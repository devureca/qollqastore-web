---
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const nav = {
    howItWorks: isEN ? "How it works" : "Cómo funciona",
    features: isEN ? "Features" : "Características",
    stack: isEN ? "Stack" : "Stack",
    install: isEN ? "Install" : "Instalación",
    demo: isEN ? "Live demo" : "Ver demo",
    otherLang: isEN ? "ES" : "EN",
    otherHref: isEN ? "/" : "/en",
};

// Fetch stars at build time — no token needed, public repo
let stars = "—";
try {
    const res = await fetch(
        "https://api.github.com/repos/devureca/qollqastore",
    );
    if (res.ok) {
        const data = await res.json();
        stars = data.stargazers_count?.toLocaleString() ?? "—";
    }
} catch {}
---

<header
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
    <div
        class="max-w-6xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between"
        style="border-bottom: 1px solid var(--border);"
    >
        <!-- Logo -->
        <a
            href={lang === "en" ? "/en" : "/"}
            class="flex items-center gap-2 font-display font-extrabold text-base tracking-tight"
        >
            <span
                class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-sm font-bold"
                style="background-color: var(--accent);">Q</span
            >
            <span style="color: var(--text);"
                >Qollqa<span style="color: var(--accent);">Store</span></span
            >
        </a>

        <!-- Center links (desktop) -->
        <nav class="hidden md:flex items-center gap-8">
            <a
                href="#how-it-works"
                class="nav-link text-sm font-medium"
                style="color: var(--text-muted);">{nav.howItWorks}</a
            >
            <a
                href="#features"
                class="nav-link text-sm font-medium"
                style="color: var(--text-muted);">{nav.features}</a
            >
            <a
                href="#stack"
                class="nav-link text-sm font-medium"
                style="color: var(--text-muted);">{nav.stack}</a
            >
            <a
                href="#install"
                class="nav-link text-sm font-medium"
                style="color: var(--text-muted);">{nav.install}</a
            >
        </nav>

        <!-- Right side (desktop) -->
        <div class="hidden md:flex items-center gap-5">
            <!-- GitHub stars -->
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener noreferrer"
                class="stars-badge"
                aria-label={`${stars} stars on GitHub`}
            >
                <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                    ></path>
                </svg>
                <span>{stars}</span>
            </a>

            <!-- Lang toggle -->
            <a
                href={nav.otherHref}
                class="text-sm font-medium nav-link"
                style="color: var(--text-muted);">{nav.otherLang}</a
            >

            <!-- Theme toggle -->
            <button
                id="theme-toggle"
                aria-label="Toggle theme"
                style="color: var(--text-muted);"
            >
                <svg
                    id="icon-sun"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="hidden"
                >
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line><line
                        x1="12"
                        y1="21"
                        x2="12"
                        y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
                        x1="18.36"
                        y1="18.36"
                        x2="19.78"
                        y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line><line
                        x1="21"
                        y1="12"
                        x2="23"
                        y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
                        x1="18.36"
                        y1="5.64"
                        x2="19.78"
                        y2="4.22"></line>
                </svg>
                <svg
                    id="icon-moon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Mobile right -->
        <div class="flex md:hidden items-center gap-3">
            <!-- GitHub stars (mobile) -->
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener noreferrer"
                class="stars-badge"
                aria-label={`${stars} stars on GitHub`}
            >
                <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                    ></path>
                </svg>
                <span>{stars}</span>
            </a>

            <a
                href={nav.otherHref}
                class="text-sm font-medium"
                style="color: var(--text-muted);">{nav.otherLang}</a
            >

            <button
                id="theme-toggle-mobile"
                aria-label="Toggle theme"
                style="color: var(--text-muted);"
            >
                <svg
                    id="icon-sun-mobile"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="hidden"
                >
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line><line
                        x1="12"
                        y1="21"
                        x2="12"
                        y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
                        x1="18.36"
                        y1="18.36"
                        x2="19.78"
                        y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line><line
                        x1="21"
                        y1="12"
                        x2="23"
                        y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
                        x1="18.36"
                        y1="5.64"
                        x2="19.78"
                        y2="4.22"></line>
                </svg>
                <svg
                    id="icon-moon-mobile"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </svg>
            </button>

            <button
                id="menu-toggle"
                aria-label="Toggle menu"
                class="w-8 h-8 flex flex-col items-center justify-center gap-1.5"
            >
                <span
                    class="hamburger-line w-5 h-0.5 transition-all duration-300"
                    style="background-color: var(--text);"></span>
                <span
                    class="hamburger-line w-5 h-0.5 transition-all duration-300"
                    style="background-color: var(--text);"></span>
                <span
                    class="hamburger-line w-5 h-0.5 transition-all duration-300"
                    style="background-color: var(--text);"></span>
            </button>
        </div>
    </div>
</header>

<!-- Mobile menu -->
<div
    id="mobile-menu"
    class="fixed inset-0 z-40 flex flex-col px-4 pt-20 pb-10 gap-6 pointer-events-none opacity-0 transition-opacity duration-300"
    style="background-color: var(--bg);"
>
    <nav class="flex flex-col gap-2">
        <a
            href="#how-it-works"
            class="mobile-nav-link py-4 text-2xl font-display font-bold border-b"
            style="color: var(--text); border-color: var(--border);"
            >{nav.howItWorks}</a
        >
        <a
            href="#features"
            class="mobile-nav-link py-4 text-2xl font-display font-bold border-b"
            style="color: var(--text); border-color: var(--border);"
            >{nav.features}</a
        >
        <a
            href="#stack"
            class="mobile-nav-link py-4 text-2xl font-display font-bold border-b"
            style="color: var(--text); border-color: var(--border);"
            >{nav.stack}</a
        >
        <a
            href="#install"
            class="mobile-nav-link py-4 text-2xl font-display font-bold border-b"
            style="color: var(--text); border-color: var(--border);"
            >{nav.install}</a
        >
        <a
            href="#faq"
            class="mobile-nav-link py-4 text-2xl font-display font-bold border-b"
            style="color: var(--text); border-color: var(--border);">FAQ</a
        >
    </nav>
</div>

<!-- Spacer -->
<div class="h-16"></div>

<style>
    #navbar {
        background-color: var(--bg);
    }
    .nav-link {
        transition: color 0.2s ease;
    }
    .nav-link:hover {
        color: var(--text) !important;
    }

    /* ── Stars badge ── */
    .stars-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background-color: var(--bg-2);
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        transition:
            border-color 0.2s ease,
            color 0.2s ease;
    }
    .stars-badge:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    #mobile-menu.open {
        opacity: 1;
        pointer-events: all;
    }
    .menu-open .hamburger-line:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }
    .menu-open .hamburger-line:nth-child(2) {
        opacity: 0;
    }
    .menu-open .hamburger-line:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }
</style>

<script>
    function setupThemeToggle(btnId: string, sunId: string, moonId: string) {
        const btn = document.getElementById(btnId);
        const sun = document.getElementById(sunId);
        const moon = document.getElementById(moonId);

        function updateIcons() {
            const isDark = document.documentElement.classList.contains("dark");
            sun?.classList.toggle("hidden", !isDark);
            moon?.classList.toggle("hidden", isDark);
        }

        updateIcons();
        btn?.addEventListener("click", () => {
            const isDark = document.documentElement.classList.toggle("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            updateIcons();
            const otherSun = document.getElementById(
                sunId === "icon-sun" ? "icon-sun-mobile" : "icon-sun",
            );
            const otherMoon = document.getElementById(
                moonId === "icon-moon" ? "icon-moon-mobile" : "icon-moon",
            );
            otherSun?.classList.toggle("hidden", !isDark);
            otherMoon?.classList.toggle("hidden", isDark);
        });
    }

    setupThemeToggle("theme-toggle", "icon-sun", "icon-moon");
    setupThemeToggle(
        "theme-toggle-mobile",
        "icon-sun-mobile",
        "icon-moon-mobile",
    );

    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    menuToggle?.addEventListener("click", () => {
        menuToggle.classList.toggle("menu-open");
        mobileMenu?.classList.toggle("open");
        document.body.classList.toggle("overflow-hidden");
    });

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", () => {
            menuToggle?.classList.remove("menu-open");
            mobileMenu?.classList.remove("open");
            document.body.classList.remove("overflow-hidden");
        });
    });
</script>
