---
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
    badge: isEN ? "✦ Free web catalog" : "✦ Catálogo web gratuito",
    title1: isEN ? "Your online store." : "Tu tienda online.",
    title2: isEN ? "No backend." : "Sin backend.",
    title3: isEN ? "No costs." : "Sin costos.",
    sub: isEN
        ? "QollqaStore turns a Google Sheet into a fully-featured web catalog. Fork, connect your Sheet and deploy to Vercel in minutes."
        : "QollqaStore convierte un Google Sheet en un catálogo web completo. Haz fork, conecta tu Sheet y despliega en Vercel en minutos.",
    cta1: isEN ? "Create my store" : "Crear mi tienda",
    cta2: isEN ? "Live demo" : "Ver demo",
    stat1: isEN ? "100% free" : "100% gratis",
    stat2: isEN ? "Live in ~5 min" : "En línea en ~5 min",
    stat3: isEN ? "No code needed" : "Sin código",
};
---

<section
    class="relative min-h-[90vh] flex flex-col items-center justify-center px-6 py-24 overflow-hidden"
>
    <!-- Background glow -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full opacity-20 blur-[120px]"
            style="background: radial-gradient(circle, #E95420 0%, transparent 70%);"
        >
        </div>
    </div>

    <!-- Badge -->
    <div class="reveal mb-6">
        <span class="badge">{t.badge}</span>
    </div>

    <!-- Title -->
    <h1
        class="reveal text-center font-display font-extrabold leading-none tracking-tight mb-6"
        style="font-size: clamp(3rem, 9vw, 7.5rem); color: var(--text);"
    >
        {t.title1}<br />
        {t.title2}<br />
        <span style="color: var(--accent);">{t.title3}</span>
    </h1>

    <!-- Subtitle -->
    <p
        class="reveal text-center max-w-xl text-lg leading-relaxed mb-10"
        style="color: var(--text-muted); animation-delay: 0.1s;"
    >
        {t.sub}
    </p>

    <!-- CTAs -->
    <div
        class="reveal flex flex-wrap items-center justify-center gap-4 mb-16"
        style="animation-delay: 0.2s;"
    >
        <a
            href="https://github.com/devureca/qollqastore"
            target="_blank"
            rel="noopener"
            class="btn-primary"
        >
            {t.cta1} →
        </a>
        <a
            href="https://qollqastore.vercel.app"
            target="_blank"
            rel="noopener"
            class="btn-ghost"
        >
            {t.cta2} ↗
        </a>
    </div>

    <!-- Stats -->
    <div
        class="reveal flex flex-wrap items-center justify-center gap-8"
        style="animation-delay: 0.3s;"
    >
        <div class="flex items-center gap-2">
            <span
                class="w-2 h-2 rounded-full"
                style="background-color: var(--accent);"></span>
            <span class="text-sm font-medium" style="color: var(--text-muted);"
                >{t.stat1}</span
            >
        </div>
        <div class="flex items-center gap-2">
            <span
                class="w-2 h-2 rounded-full"
                style="background-color: var(--accent);"></span>
            <span class="text-sm font-medium" style="color: var(--text-muted);"
                >{t.stat2}</span
            >
        </div>
        <div class="flex items-center gap-2">
            <span
                class="w-2 h-2 rounded-full"
                style="background-color: var(--accent);"></span>
            <span class="text-sm font-medium" style="color: var(--text-muted);"
                >{t.stat3}</span
            >
        </div>
    </div>

    <!-- Screenshot mockup -->
    <div
        class="reveal w-full max-w-4xl mt-20 mx-auto"
        style="animation-delay: 0.4s;"
    >
        <div
            class="relative rounded-2xl overflow-hidden"
            style="border: 1px solid var(--border); background-color: var(--bg-2);"
        >
            <!-- Browser bar -->
            <div
                class="flex items-center gap-2 px-4 py-3"
                style="border-bottom: 1px solid var(--border);"
            >
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
                <div
                    class="flex-1 mx-4 rounded-full py-1 px-4 text-xs font-mono text-center"
                    style="background-color: var(--bg-3); color: var(--text-muted);"
                >
                    tutienda.vercel.app
                </div>
            </div>

            <!-- Demo content placeholder -->
            <div class="p-8 min-h-[320px] flex flex-col gap-4">
                <!-- Fake navbar -->
                <div class="flex items-center justify-between">
                    <div
                        class="w-24 h-4 rounded-full"
                        style="background-color: var(--bg-3);"
                    >
                    </div>
                    <div class="flex gap-2">
                        <div
                            class="w-16 h-4 rounded-full"
                            style="background-color: var(--bg-3);"
                        >
                        </div>
                        <div
                            class="w-16 h-4 rounded-full"
                            style="background-color: var(--bg-3);"
                        >
                        </div>
                        <div
                            class="w-20 h-7 rounded-full"
                            style="background-color: var(--accent); opacity: 0.7;"
                        >
                        </div>
                    </div>
                </div>

                <!-- Fake product grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
                    {
                        [1, 2, 3, 4].map((i) => (
                            <div
                                class="rounded-xl overflow-hidden"
                                style="border: 1px solid var(--border);"
                            >
                                <div
                                    class="h-24 w-full"
                                    style={`background-color: var(--bg-3); opacity: ${0.4 + i * 0.15};`}
                                />
                                <div class="p-3 flex flex-col gap-2">
                                    <div
                                        class="h-3 w-3/4 rounded-full"
                                        style="background-color: var(--bg-3);"
                                    />
                                    <div
                                        class="h-3 w-1/2 rounded-full"
                                        style="background-color: var(--accent); opacity: 0.5;"
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Glow under mockup -->
        <div
            class="h-12 blur-2xl opacity-30 -mt-6 mx-12 rounded-full"
            style="background-color: var(--accent);"
        >
        </div>
    </div>
</section>
