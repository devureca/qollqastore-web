---
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
    title1: isEN ? "Your store online." : "Tu tienda online.",
    title2: isEN ? "Completely free." : "Completamente gratis.",
    sub: isEN
        ? "Use a Google spreadsheet as your product catalog. Edit it anytime and your store updates instantly — no monthly fees, no technical knowledge."
        : "Usa una hoja de Google como tu catálogo de productos. Edítala cuando quieras y tu tienda se actualiza al instante — sin mensualidades, sin conocimientos técnicos.",
    cta1: isEN ? "Create my store" : "Crear mi tienda",
    cta2: isEN ? "See example" : "Ver ejemplo",
    stat1: isEN ? "100% free" : "100% gratis",
    stat2: isEN ? "Ready in 5 min" : "Lista en 5 min",
    stat3: isEN ? "No tech skills" : "Sin conocimientos técnicos",
};
---

<section
    class="hero-section relative min-h-[92vh] flex flex-col items-center justify-center px-6 py-24 overflow-hidden"
>
    <!-- Grid background -->
    <div class="grid-bg absolute inset-0 pointer-events-none"></div>

    <!-- Top fade -->
    <div
        class="absolute top-0 left-0 right-0 h-32 pointer-events-none"
        style="background: linear-gradient(to bottom, var(--bg), transparent);"
    >
    </div>

    <!-- Bottom fade -->
    <div
        class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none"
        style="background: linear-gradient(to top, var(--bg), transparent);"
    >
    </div>

    <!-- Content -->
    <div
        class="relative z-10 flex flex-col items-center text-center max-w-4xl mx-auto"
    >
        <!-- Title -->
        <h1
            class="reveal font-display font-extrabold tracking-tight mb-6"
            style="animation-delay: 0.05s; color: var(--text);"
        >
            <span
                class="block leading-none"
                style="font-size: clamp(2.5rem, 7vw, 6rem);"
            >
                {t.title1}
            </span>
            <span
                class="block leading-none"
                style="font-size: clamp(1.5rem, 4vw, 3rem); color: var(--text-muted);"
            >
                {t.title2}
            </span>
        </h1>

        <!-- Subtitle -->
        <p
            class="reveal text-lg leading-relaxed mb-10 max-w-xl"
            style="color: var(--text-muted); animation-delay: 0.1s;"
        >
            {t.sub}
        </p>

        <!-- CTAs -->
        <div
            class="reveal flex flex-wrap items-center justify-center gap-4 mb-16"
            style="animation-delay: 0.15s;"
        >
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener"
                class="btn-primary px-8 py-3 text-base"
            >
                {t.cta1} →
            </a>
            <a
                href="https://qollqastore.vercel.app"
                target="_blank"
                rel="noopener"
                class="btn-ghost px-8 py-3 text-base"
            >
                {t.cta2} ↗
            </a>
        </div>

        <!-- Stats -->
        <div
            class="reveal flex flex-wrap items-center justify-center gap-8"
            style="animation-delay: 0.2s;"
        >
            <div class="flex items-center gap-2">
                <span
                    class="w-1.5 h-1.5 rounded-full"
                    style="background-color: var(--accent);"></span>
                <span
                    class="text-sm font-medium"
                    style="color: var(--text-muted);">{t.stat1}</span
                >
            </div>
            <div class="flex items-center gap-2">
                <span
                    class="w-1.5 h-1.5 rounded-full"
                    style="background-color: var(--accent);"></span>
                <span
                    class="text-sm font-medium"
                    style="color: var(--text-muted);">{t.stat2}</span
                >
            </div>
            <div class="flex items-center gap-2">
                <span
                    class="w-1.5 h-1.5 rounded-full"
                    style="background-color: var(--accent);"></span>
                <span
                    class="text-sm font-medium"
                    style="color: var(--text-muted);">{t.stat3}</span
                >
            </div>
        </div>
    </div>
</section>

<style>
    /* Light mode */
    .grid-bg {
        background-image:
            linear-gradient(rgba(0, 0, 0, 0.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 0, 0, 0.06) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    /* Dark mode */
    :global(.dark) .grid-bg {
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.06) 1px,
                transparent 1px
            );
        background-size: 40px 40px;
    }
</style>
