---
interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEN = lang === 'en';

const t = {
  badge: isEN ? '✦ Installation' : '✦ Instalación',
  title: isEN ? 'Up and running\nin minutes.' : 'En línea\nen minutos.',
  steps: [
    {
      id: 'step1',
      tab:   isEN ? 'Fork the repo'        : 'Fork del repo',
      title: isEN ? 'Fork the repository'  : 'Haz fork del repositorio',
      desc:  isEN ? 'Go to GitHub and click Fork. Rename it to your store name — that will be your URL.'
                  : 'Ve a GitHub y haz clic en Fork. Renómbralo con el nombre de tu tienda — ese será tu URL.',
    },
    {
      id: 'step2',
      tab:   isEN ? 'Copy the Sheet'       : 'Copia el Sheet',
      title: isEN ? 'Copy the Google Sheet template' : 'Copia el template de Google',
      desc:  isEN ? 'Open our template and click File → Make a copy. This will be your store\'s database.'
                  : 'Abre nuestro template y haz clic en Archivo → Hacer una copia. Esta será la base de datos de tu tienda.',
    },
    {
      id: 'step3',
      tab:   isEN ? 'Fill your data'       : 'Completa tus datos',
      title: isEN ? 'Fill in your products and info' : 'Completa tus productos e info',
      desc:  isEN ? 'Fill the 6 tabs with your products, colors, social links and contact info. No code needed.'
                  : 'Completa las 6 pestañas con tus productos, colores, redes sociales e información de contacto. Sin código.',
    },
    {
      id: 'step4',
      tab:   isEN ? 'Share the Sheet'      : 'Comparte el Sheet',
      title: isEN ? 'Make the Sheet public' : 'Haz el Sheet público',
      desc:  isEN ? 'Click Share → Anyone with the link → Viewer. This allows your store to read the data.'
                  : 'Haz clic en Compartir → Cualquier persona con el enlace → Lector. Esto permite que tu tienda lea los datos.',
    },
    {
      id: 'step5',
      tab:   isEN ? 'Deploy on Vercel'     : 'Despliega en Vercel',
      title: isEN ? 'Deploy your store on Vercel' : 'Despliega tu tienda en Vercel',
      desc:  isEN ? 'Import your fork on Vercel, add your Sheet ID as an environment variable and click Deploy. Done!'
                  : 'Importa tu fork en Vercel, agrega el ID de tu Sheet como variable de entorno y haz clic en Deploy. ¡Listo!',
    },
  ]
}
---

<section id="install" class="py-24 px-4 md:px-8">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="reveal text-center mb-16">
      <span class="badge mb-4 inline-block">{t.badge}</span>
      <h2 class="font-display font-extrabold"
        style="font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text);">
        {t.title}
      </h2>
    </div>

    <!-- Tabs layout -->
    <div class="reveal flex flex-col md:flex-row gap-4 md:gap-8">

      <!-- Left: tabs -->
      <div class="flex flex-row md:flex-col gap-2 md:w-56 shrink-0 overflow-x-auto md:overflow-visible pb-2 md:pb-0">
        {t.steps.map((step, i) => (
          <button
            class="install-tab text-left px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 shrink-0 md:shrink"
            data-tab={step.id}
            style={i === 0
              ? 'background-color: var(--accent); color: #fff;'
              : 'background-color: var(--bg-2); color: var(--text-muted); border: 1px solid var(--border);'
            }
          >
            <span class="font-mono text-xs block mb-0.5 opacity-60">0{i + 1}</span>
            {step.tab}
          </button>
        ))}
      </div>

      <!-- Right: content -->
      <div class="flex-1 rounded-2xl overflow-hidden" style="border: 1px solid var(--border);">
        {t.steps.map((step, i) => (
          <div
            class="install-panel h-full"
            data-panel={step.id}
            style={i !== 0 ? 'display: none;' : ''}
          >
            <!-- Video placeholder -->
            <div class="w-full flex items-center justify-center"
              style="background-color: var(--bg-3); aspect-ratio: 16/9;">
              <div class="flex flex-col items-center gap-3" style="color: var(--text-muted);">
                <div class="w-14 h-14 rounded-full flex items-center justify-center"
                  style="border: 2px solid var(--border);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
                <span class="text-xs font-mono">Video — paso 0{i + 1}</span>
              </div>
            </div>

            <!-- Text -->
            <div class="p-6 md:p-8">
              <h3 class="font-display font-bold text-xl mb-3" style="color: var(--text);">
                {step.title}
              </h3>
              <p class="text-base leading-relaxed" style="color: var(--text-muted);">
                {step.desc}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.install-tab');
  const panels = document.querySelectorAll('.install-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      // Reset all tabs
      tabs.forEach(t => {
        (t as HTMLElement).style.backgroundColor = 'var(--bg-2)';
        (t as HTMLElement).style.color = 'var(--text-muted)';
        (t as HTMLElement).style.border = '1px solid var(--border)';
      });

      // Active tab
      (tab as HTMLElement).style.backgroundColor = 'var(--accent)';
      (tab as HTMLElement).style.color = '#fff';
      (tab as HTMLElement).style.border = 'none';

      // Show panel
      panels.forEach(p => {
        (p as HTMLElement).style.display =
          p.getAttribute('data-panel') === target ? '' : 'none';
      });
    });
  });
</script>