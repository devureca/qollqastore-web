---
interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
  badge: isEN ? "✦ See it in action" : "✦ Míralo en acción",
  title: isEN
    ? "A real store,\nready to use."
    : "Una tienda real,\nlista para usar.",
  sub: isEN
    ? "This is what your customers will see. Edit your Google Sheet and the store updates instantly."
    : "Esto es lo que verán tus clientes. Edita tu hoja de Google y la tienda se actualiza al instante.",
  cta: isEN ? "See live demo" : "Ver demo en vivo",
};
---

<section id="how-it-works" class="py-24 px-4 md:px-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="reveal text-center mb-12">
      <span class="badge mb-4 inline-block">{t.badge}</span>
      <h2
        class="font-display font-extrabold whitespace-pre-line mb-4"
        style="font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text);"
      >
        {t.title}
      </h2>
      <p
        class="max-w-lg mx-auto text-base leading-relaxed"
        style="color: var(--text-muted);"
      >
        {t.sub}
      </p>
    </div>

    <!-- Mockup browser -->
    <div
      class="reveal rounded-2xl overflow-hidden"
      style="border: 1px solid var(--border);"
    >
      <!-- Browser bar -->
      <div
        class="flex items-center gap-2 px-4 py-3"
        style="background-color: var(--bg-2); border-bottom: 1px solid var(--border);"
      >
        <span
          class="w-3 h-3 rounded-full"
          style="background-color: var(--bg-3);"></span>
        <span
          class="w-3 h-3 rounded-full"
          style="background-color: var(--bg-3);"></span>
        <span
          class="w-3 h-3 rounded-full"
          style="background-color: var(--bg-3);"></span>
        <div
          class="flex-1 mx-4 rounded-full py-1 px-4 text-xs font-mono text-center"
          style="background-color: var(--bg-3); color: var(--text-muted);"
        >
          tutienda.vercel.app
        </div>
      </div>

      <!-- Mockup content -->
      <div
        class="p-4 md:p-6 overflow-y-auto"
        style="background-color: var(--bg-2); max-height: 560px;"
      >
        <!-- Fake navbar -->
        <div class="flex items-center justify-between mb-6 px-2">
          <div
            class="w-24 h-4 rounded-full"
            style="background-color: var(--bg-3);"
          >
          </div>
          <div class="hidden md:flex items-center gap-3">
            <div
              class="w-14 h-3 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
            <div
              class="w-14 h-3 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
            <div
              class="w-14 h-3 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
            <div
              class="w-14 h-3 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div
              class="w-6 h-6 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
            <div
              class="w-6 h-6 rounded-full"
              style="background-color: var(--bg-3);"
            >
            </div>
            <div
              class="w-20 h-7 rounded-full"
              style="background-color: var(--accent); opacity: 0.5;"
            >
            </div>
          </div>
        </div>

        <!-- Hero slider -->
        <div
          class="w-full h-36 md:h-48 rounded-xl mb-6 flex items-center justify-center"
          style="background-color: var(--bg-3);"
        >
          <div class="flex flex-col items-start gap-2 px-8 w-full">
            <div
              class="w-32 h-5 rounded-full"
              style="background-color: var(--border);"
            >
            </div>
            <div
              class="w-48 h-8 rounded-full"
              style="background-color: var(--border);"
            >
            </div>
            <div
              class="w-24 h-7 rounded-full mt-2"
              style="background-color: var(--accent); opacity: 0.4;"
            >
            </div>
          </div>
        </div>

        <!-- Section label -->
        <div
          class="w-20 h-3 rounded-full mb-3"
          style="background-color: var(--bg-3);"
        >
        </div>

        <!-- Product grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
          {
            [1, 2, 3, 4, 5, 6, 7, 8].map(() => (
              <div
                class="rounded-xl overflow-hidden"
                style="border: 1px solid var(--border);"
              >
                <div
                  class="w-full h-24 flex items-center justify-center"
                  style="background-color: var(--bg-3);"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    style="color: var(--border);"
                  >
                    <>
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <circle cx="8.5" cy="8.5" r="1.5" />
                      <path d="m21 15-5-5L5 21" />
                    </>
                  </svg>
                </div>
                <div class="p-2 flex flex-col gap-1.5">
                  <div
                    class="h-2.5 w-3/4 rounded-full"
                    style="background-color: var(--bg-3);"
                  />
                  <div
                    class="h-2.5 w-1/2 rounded-full"
                    style="background-color: var(--accent); opacity: 0.3;"
                  />
                </div>
              </div>
            ))
          }
        </div>

        <!-- Section label -->
        <div
          class="w-16 h-3 rounded-full mb-3"
          style="background-color: var(--bg-3);"
        >
        </div>

        <!-- Offers row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
          {
            [1, 2, 3, 4].map(() => (
              <div
                class="rounded-xl p-3 flex items-center gap-3"
                style="background-color: var(--bg-3);"
              >
                <div
                  class="w-10 h-10 rounded-lg shrink-0"
                  style="background-color: var(--border);"
                />
                <div class="flex flex-col gap-1.5 flex-1">
                  <div
                    class="h-2 w-full rounded-full"
                    style="background-color: var(--border);"
                  />
                  <div
                    class="h-2 w-2/3 rounded-full"
                    style="background-color: var(--accent); opacity: 0.3;"
                  />
                </div>
              </div>
            ))
          }
        </div>

        <!-- Testimonials -->
        <div
          class="w-20 h-3 rounded-full mb-3"
          style="background-color: var(--bg-3);"
        >
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {
            [1, 2, 3].map(() => (
              <div
                class="rounded-xl p-4 flex flex-col gap-2"
                style="background-color: var(--bg-3);"
              >
                <div class="flex items-center gap-2">
                  <div
                    class="w-8 h-8 rounded-full"
                    style="background-color: var(--border);"
                  />
                  <div
                    class="h-2.5 w-24 rounded-full"
                    style="background-color: var(--border);"
                  />
                </div>
                <div
                  class="h-2 w-full rounded-full"
                  style="background-color: var(--border);"
                />
                <div
                  class="h-2 w-4/5 rounded-full"
                  style="background-color: var(--border);"
                />
                <div
                  class="h-2 w-3/5 rounded-full"
                  style="background-color: var(--border);"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="reveal text-center mt-8">
      <a
        href="https://qollqastore.vercel.app"
        target="_blank"
        rel="noopener"
        class="btn-ghost px-6 py-2.5 text-sm"
      >
        {t.cta} ↗
      </a>
    </div>
  </div>
</section>
