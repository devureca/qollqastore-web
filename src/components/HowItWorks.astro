---
interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
  badge: isEN ? "✦ See it in action" : "✦ Míralo en acción",
  title: isEN
    ? "A real store,\nready to use."
    : "Una tienda real,\nlista para usar.",
  sub: isEN
    ? "Edit your spreadsheet and your store updates instantly."
    : "Edita tu hoja de cálculo y tu tienda se actualiza al instante.",
  cta: isEN ? "See live demo" : "Ver demo en vivo",
  imgAlt: isEN ? "Live store demo screenshot" : "Captura del demo de la tienda",
};
---

<section id="how-it-works" class="py-24 px-4 md:px-8">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="reveal text-center mb-16">
      <span class="badge mb-4 inline-block">{t.badge}</span>
      <h2
        class="font-display font-extrabold mb-4"
        style="font-size: clamp(2rem, 5vw, 3.5rem); color: var(--text); letter-spacing: -0.03em;"
      >
        {t.title}
      </h2>
      <p
        class="max-w-lg mx-auto text-base leading-relaxed"
        style="color: var(--text-muted);"
      >
        {t.sub}
      </p>
    </div>

    <!-- Browser mockup with scroll tilt -->
    <div class="tilt-scene">
      <div class="tilt-frame" id="tiltFrame">
        <!-- Browser chrome -->
        <div class="chrome-bar">
          <span class="chrome-dot" style="background:#f87171"></span>
          <span class="chrome-dot" style="background:#fbbf24"></span>
          <span class="chrome-dot" style="background:#4ade80"></span>
          <div class="chrome-url">qollqastore.vercel.app</div>
        </div>

        <!-- Screenshot -->
        <div class="chrome-screen">
          <img
            src="/demo.png"
            alt={t.imgAlt}
            loading="lazy"
            draggable="false"
          />
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="reveal text-center mt-12">
      <a
        href="https://qollqastore.vercel.app"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost px-6 py-2.5 text-sm"
        aria-label={isEN
          ? "See live demo (opens in new tab)"
          : "Ver demo en vivo (abre en nueva pestaña)"}
      >
        {t.cta} ↗
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Scene: establece la perspectiva 3D ── */
  .tilt-scene {
    perspective: 1200px;
    perspective-origin: 50% 40%;
  }

  /* ── Frame: el mockup que se inclina ── */
  .tilt-frame {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-2);
    box-shadow:
      0 40px 80px rgba(0, 0, 0, 0.15),
      0 10px 30px rgba(0, 0, 0, 0.08);

    /* Posición inicial: recostado como en una mesa */
    transform: rotateX(32deg) scale(0.94);
    transform-origin: center bottom;
    transition: transform 0.08s linear;
    will-change: transform;
  }

  /* ── Browser chrome bar ── */
  .chrome-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }

  .chrome-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chrome-url {
    flex: 1;
    text-align: center;
    font-size: 11px;
    font-family: "JetBrains Mono", monospace;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 12px;
    max-width: 220px;
    margin: 0 auto;
  }

  /* ── Screenshot ── */
  .chrome-screen {
    display: block;
    line-height: 0;
  }

  .chrome-screen img {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  const frame = document.getElementById("tiltFrame") as HTMLElement;

  const START_DEG = 18; // inclinación inicial
  const END_DEG = 0; // posición final (de frente)
  const START_SCALE = 0.97;
  const END_SCALE = 1;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function onScroll() {
    const rect = frame.getBoundingClientRect();
    const vh = window.innerHeight;

    // progress: 0 cuando el elemento entra por abajo, 1 cuando está centrado
    const progress = Math.min(1, Math.max(0, 1 - rect.top / (vh * 1.4)));

    const deg = lerp(START_DEG, END_DEG, progress);
    const scale = lerp(START_SCALE, END_SCALE, progress);

    frame.style.transform = `rotateX(${deg}deg) scale(${scale})`;
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll(); // run once on load
</script>
