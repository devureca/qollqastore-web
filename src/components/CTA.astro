---
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
    title: isEN
        ? "Ready to publish\nyour store today?"
        : "¿Listo para publicar\ntu tienda hoy?",
    sub: isEN
        ? "Free, no backend, no hassle. Just you and your catalog."
        : "Gratis, sin backend, sin complicaciones. Solo tú y tu catálogo.",
    cta1: isEN ? "Create my free store" : "Crear mi tienda gratis",
    cta2: isEN ? "View source code" : "Ver el código",
};
---

<section class="py-24 px-6 relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full opacity-15 blur-[100px]"
            style="background: radial-gradient(circle, #E95420 0%, transparent 70%);"
        >
        </div>
    </div>

    <div class="max-w-3xl mx-auto text-center relative z-10">
        <h2
            class="reveal font-display font-extrabold whitespace-pre-line mb-6"
            style="font-size: clamp(2.5rem, 6vw, 4.5rem); color: var(--text);"
        >
            {t.title}
        </h2>

        <p
            class="reveal text-lg leading-relaxed mb-10"
            style="color: var(--text-muted); animation-delay: 0.1s;"
        >
            {t.sub}
        </p>

        <div
            class="reveal flex flex-wrap items-center justify-center gap-4"
            style="animation-delay: 0.2s;"
        >
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener"
                class="btn-primary text-lg px-8 py-4"
            >
                {t.cta1} →
            </a>
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener"
                class="btn-ghost text-lg px-8 py-4"
            >
                {t.cta2} ↗
            </a>
        </div>
    </div>
</section>
