---
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;
const isEN = lang === "en";

const t = {
    title1: isEN ? "Ready to publish" : "¿Listo para publicar",
    title2: isEN ? "your store today?" : "tu tienda hoy?",
    sub: isEN
        ? "Free, no technical knowledge, no complications. Just you and your catalog."
        : "Gratis, sin conocimientos técnicos, sin complicaciones. Solo tú y tu catálogo.",
    cta1: isEN ? "Create my free store" : "Crear mi tienda gratis",
    cta2: isEN ? "View source code" : "Ver el código",
};
---

<section class="relative py-32 px-4 md:px-8 overflow-hidden">
    <!-- Grid background naranja -->
    <div class="cta-grid absolute inset-0 pointer-events-none"></div>

    <!-- Top fade -->
    <div
        class="absolute top-0 left-0 right-0 h-32 pointer-events-none"
        style="background: linear-gradient(to bottom, var(--bg), transparent);"
    >
    </div>

    <!-- Bottom fade -->
    <div
        class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none"
        style="background: linear-gradient(to top, var(--bg), transparent);"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center">
        <h2
            class="reveal font-display font-extrabold tracking-tight mb-6"
            style="color: var(--text);"
        >
            <span
                class="block leading-none"
                style="font-size: clamp(2rem, 5vw, 4.5rem);"
            >
                {t.title1}
            </span>
            <span
                class="block leading-none"
                style="font-size: clamp(2rem, 5vw, 4.5rem); color: var(--accent);"
            >
                {t.title2}
            </span>
        </h2>

        <p
            class="reveal text-lg leading-relaxed mb-10"
            style="color: var(--text-muted); animation-delay: 0.1s;"
        >
            {t.sub}
        </p>

        <div
            class="reveal flex flex-wrap items-center justify-center gap-4"
            style="animation-delay: 0.2s;"
        >
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener"
                class="btn-primary px-8 py-3 text-base"
            >
                {t.cta1} →
            </a>
            <a
                href="https://github.com/devureca/qollqastore"
                target="_blank"
                rel="noopener"
                class="btn-ghost px-8 py-3 text-base"
            >
                {t.cta2} ↗
            </a>
        </div>
    </div>
</section>

<style>
    /* Light mode */
    .cta-grid {
        background-image:
            linear-gradient(rgba(233, 84, 32, 0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(233, 84, 32, 0.08) 1px, transparent 1px);
        background-size: 40px 40px;
    }

    /* Dark mode */
    :global(.dark) .cta-grid {
        background-image:
            linear-gradient(rgba(233, 84, 32, 0.1) 1px, transparent 1px),
            linear-gradient(90deg, rgba(233, 84, 32, 0.1) 1px, transparent 1px);
        background-size: 40px 40px;
    }
</style>
